# Optional local server configuration. Never copy secrets into VITE_ variables.
PORT=3001
HOST=127.0.0.1
DB_PATH=data/ledger.sqlite
COOKIE_SECURE=0
# LOCAL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# AI vision provider for screenshot extraction.
# Supported: gemini, openai, ollama. Leave blank for manual-only mode.
AI_PROVIDER=
AI_MODEL=

# Provider-specific defaults (override only when needed):
#   gemini  → https://generativelanguage.googleapis.com  (API key required)
#   openai  → https://api.openai.com/v1                  (API key required)
#   ollama  → http://127.0.0.1:11434                     (local, key optional)
AI_BASE_URL=
AI_API_KEY=

# Examples:
#   AI_PROVIDER=gemini   AI_MODEL=gemini-2.0-flash   AI_API_KEY=your-key
#   AI_PROVIDER=openai   AI_MODEL=gpt-4o             AI_API_KEY=sk-...
#   AI_PROVIDER=ollama   AI_MODEL=llava              AI_BASE_URL=http://127.0.0.1:11434
