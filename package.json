{
  "name": "ledgersprout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@fastify/static": { "glob": "14.0.2" },
    "minimatch": "^11.0.1",
    "exceljs": { "uuid": "^11.1.1" }
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --include server --include shared server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "tsx watch --include server --include shared server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 tests/flows.test.ts tests/ui-*.test.ts tests/qa.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^10.1.8",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
